<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_card_gradient"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/ic_receipt_header"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:src="@drawable/ic_receipt"
                app:tint="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/ic_receipt_header"
                android:layout_marginStart="10dp"
                android:text="LẬP HÓA ĐƠN &amp; VIETQR"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuayLaiHoaDon"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Quay lại"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="#FFFFFF"
                app:strokeColor="#FFFFFF"
                app:cornerRadius="20dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Form Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_section_header"
                        android:padding="10dp"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_receipt"
                            app:tint="@color/primary"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thông tin hóa đơn"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"/>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Mã hóa đơn (VD: HD101-11)"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxStrokeColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtmahoadon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Chọn phòng cho thuê"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp">

                        <AutoCompleteTextView
                            android:id="@+id/txtmaphong"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Chi tiết tính tiền -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/accent_blue_light">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:text="📊 CHI TIẾT TÍNH TIỀN TỰ ĐỘNG"
                                android:textColor="@color/accent_blue"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="🏠 Tiền thuê phòng:"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"/>

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/txttienphong"
                                    android:layout_width="120dp"
                                    android:layout_height="40dp"
                                    android:background="@color/bg_card"
                                    android:hint="0"
                                    android:inputType="numberDecimal"
                                    android:padding="8dp"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="⚡ Điện nước &amp; Dịch vụ (Auto):"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"/>

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/txtphidichvu"
                                    android:layout_width="120dp"
                                    android:layout_height="40dp"
                                    android:background="@color/bg_card"
                                    android:hint="0"
                                    android:inputType="numberDecimal"
                                    android:padding="8dp"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Tổng tiền -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/accent_red_light">

                        <TextView
                            android:id="@+id/txttongtien"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="TỔNG TIỀN: 0 VNĐ"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_red"
                            android:gravity="center"
                            android:padding="16dp"/>
                    </androidx.cardview.widget.CardView>

                    <!-- Action Buttons -->
                    <Button
                        android:id="@+id/btnthem"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="💾 LƯU &amp; XÁC NHẬN HÓA ĐƠN"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/btn_green_rounded"
                        android:stateListAnimator="@null"
                        android:layout_marginBottom="10dp"/>

                    <Button
                        android:id="@+id/btnVietQR"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="📱 TẠO MÃ VIETQR &amp; GỬI ZALO/SMS"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="@color/accent_blue"
                        android:stateListAnimator="@null"
                        android:layout_marginBottom="10dp"/>

                    <Button
                        android:id="@+id/btnxoa"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="🔄 Làm Mới Form"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/btn_gray_rounded"
                        android:stateListAnimator="@null"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- List header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_section_header"
                android:padding="10dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_receipt"
                    app:tint="@color/primary"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Danh Sách Hóa Đơn Đã Lập"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>

            <ListView
                android:id="@+id/lvhoadon"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="@color/bg_card"
                android:layout_marginBottom="16dp"
                android:divider="@color/divider"
                android:dividerHeight="1dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
